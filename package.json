{
  "name": "@johpaz/hivelearn",
  "version": "0.1.0",
  "description": "HiveLearn — Plataforma de aprendizaje adaptativo con IA",
  "type": "module",
  "bin": {
    "hivelearn": "./dist/hive.js",
    "hive": "./dist/hive.js"
  },
  "main": "./dist/hive.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:sdk": "HIVELEARN_AGENT_ENGINE=sdk bun run scripts/dev.ts",
    "dev:ui": "bun run --cwd packages/hivelearn-ui dev",
    "dev:server": "NODE_ENV=development bun run --cwd packages/core dev",
    "dev:cli": "bun run --cwd packages/cli dev",
    "build": "bun run scripts/build.ts",
    "build:core": "bun build packages/core/src/index.ts --outdir dist/core --target bun --external @johpaz/hive-db && bun build packages/core/src/gateway/index.ts --bundle --outfile dist/server.js --target bun --external @johpaz/hive-db",
    "build:ui": "bun run --cwd packages/hivelearn-ui build",
    "build:cli": "bun run --cwd packages/cli build",
    "start": "bun run --cwd packages/cli src/index.ts start",
    "test": "bun test",
    "test:e2e": "bun run build:ui && RUN_WEBVIEW_TESTS=1 bun test tests/e2e",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules dist"
  },
  "dependencies": {
    "@johpaz/hive-db": "0.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "latest",
    "typescript": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
