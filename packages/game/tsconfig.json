{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["bun"],
    "paths": {
      "@hivelearn/core/*": ["../core/src/*"],
      "@hivelearn/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
