" y="240" width="260" height="36" as="geometry"/></mxCell><mxCell id="c8" value="Datos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE08A;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="284" width="260" height="36" as="geometry"/></mxCell><mxCell id="c9" value="Alumno / portal&lt;br&gt;perfil, edad, meta, currículo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#5B2C83;strokeColor=#2B0F45;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="300" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Política por edad (código)&lt;br&gt;edad desconocida = banda restrictiva;&lt;br&gt;proveedor remoto solo si la institución lo permite" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Currículo y ruta del alumno&lt;br&gt;IA o cualquier tema; solo canónico o&lt;br&gt;revisado acredita" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE08A;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Coordinador planifica el blueprint&lt;br&gt;planificar_programa, con la ruta curricular&lt;br&gt;y la memoria del alumno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1B4F8A;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="300" height="80" as="geometry"/></mxCell><mxCell id="c13" value="¿Blueprint válido contra&lt;br&gt;el currículo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="380" width="260" height="100" as="geometry"/></mxCell><mxCell id="c14" value="El coordinador recibe el motivo y las&lt;br&gt;competencias permitidas (hasta 3 intentos)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1B4F8A;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="395" width="300" height="70" as="geometry"/></mxCell><mxCell id="c15" value="Kev reparte el trabajo (una consulta por nodo)&lt;br&gt;agente visual y skills pedagógicas,&lt;br&gt;solo entre candidatos permitidos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#B34A00;strokeColor=#5C2600;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="300" height="100" as="geometry"/></mxCell><mxCell id="c16" value="RONDA 1 · trabajos independientes en paralelo&lt;br&gt;(tope = HIVELEARN_MAX_CONCURRENT_WORKERS = paralelismo del backend)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;verticalAlign=top;fontStyle=1;dashPattern=8 4;fillColor=#DDF0DD;strokeColor=#0B3A15;fontColor=#000000;fontSize=14;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="640" height="170" as="geometry"/></mxCell><mxCell id="c17" value="Explicación&lt;br&gt;concept, milestone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="190" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Ejercicio&lt;br&gt;exercise, challenge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="265" y="760" width="190" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Evaluación del nodo&lt;br&gt;quiz"