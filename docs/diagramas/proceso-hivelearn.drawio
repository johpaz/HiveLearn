4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="dudoso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Capas y quién decide qué"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Identidad y política&lt;br&gt;&lt;br&gt;cuentas, roles, registro adulto,&lt;br&gt;bandas de edad, proveedor&lt;br&gt;permitido por edad e institución" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#5B2C83;strokeColor=#2B0F45;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c3" value="Currículo&lt;br&gt;&lt;br&gt;cualquier tema como dato validado;&lt;br&gt;canonical / generated / reviewed;&lt;br&gt;progreso por alumno y currículo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE08A;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="255" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c4" value="Investigación&lt;br&gt;&lt;br&gt;búsqueda y descarga seguras;&lt;br&gt;dossier de afirmaciones con&lt;br&gt;fuentes reales" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c5" value="Coordinador + Kev&lt;br&gt;&lt;br&gt;planifica, delega por rondas;&lt;br&gt;Kev elige visual, skills,&lt;br&gt;esfuerzo y longitud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1B4F8A;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="705" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c6" value="Entrega&lt;br&gt;&lt;br&gt;tutor interactivo A2UI,&lt;br&gt;corrección, ayuda tras fallos,&lt;br&gt;recorrido guiado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c7" value="Evaluación&lt;br&gt;&lt;br&gt;corrección determinista,&lt;br&gt;regla híbrida, evidencia,&lt;br&gt;nivel y cola de revisión" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1155" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c8" value="Seguridad&lt;br&gt;&lt;br&gt;puerta determinista previa&lt;br&gt;a la entrega; ningún nodo&lt;br&gt;promete un visual inexistente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="200" height="180" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Principios: sin grafo de tareas · Kev decide, el código garantiza · la clave de respuesta manda ·&lt;br&gt;edad desconocida = banda restrictiva · lo generado no acredita" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE08A;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="1550" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Motores de agentes: legacy (loop propio, predeterminado) y sdk (@johpaz/hive-sdk), mismo contrato y ambos verificados con modelo real" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="1550" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Motor del SDK y guardrails"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Una ejecución de agente · runHiveLearnAgent (mismo contrato en los motores legacy y sdk)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE08A;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="620" height="60" as="geometry"/></mxCell><mxCell id="c3" value="GUARDRAIL 1 · Política de proveedor por edad e institución&lt;br&gt;edad desconocida = restrictiva; remoto solo con allowRemoteProviders;&lt;br&gt;menores solo con allowRemoteForMinors (assertProviderAllowed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="620" height="100" as="geometry"/></mxCell><mxCell id="c4" value="GUARDRAIL 2 · Constitución de HiveLearn al inicio del system prompt&lt;br&gt;reglas comunes + menor / adulto. El SDK NO inyecta su ética&lt;br&gt;cuando se le pasa un prompt propio (systemPromptOverride)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="620" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Aislamiento · agente efímero en una base propia del SDK (sdk-db),&lt;br&gt;sin mezclar proveedores ni modelos de HiveLearn; una corrida a la vez" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="620" height="100" as="geometry"/></mxCell><mxCell id="c6" value="GUARDRAIL 3 · Lista blanca de tools&lt;br&gt;solo las de esta corrida; sin tools nativas del SDK (web, cli, browser)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="620" height="100" as="geometry"/></mxCell><mxCell id="c7" value="GUARDRAIL 4 · Oráculo Kev / Jev&lt;br&gt;share = nada (solo el objetivo del turno), verify = apagado;&lt;br&gt;respeta oracleEnabled y la política de edad" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#B34A00;strokeColor=#5C2600;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="620" height="100" as="geometry"/></mxCell><mxCell id="c8" value="Loop del SDK · itera hasta maxIterations&lt;br&gt;(esfuerzo de razonamiento decidido por el especialista)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1B4F8A;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="620" height="100" as="geometry"/></mxCell><mxCell id="c9" value="GUARDRAIL 5 · Hook beforeToolCall&lt;br&gt;bloquea toda tool que no sea de la corrida en curso&lt;br&gt;(es global y fail-open: por eso la lista blanca va primero)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="620" height="100" as="geometry"/></mxCell><mxCell id="c10" value="Ejecución de la tool con tiempo máximo&lt;br&gt;(enviar_interaccion 6 min, delegar_a_enjambre 30 min)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="620" height="100" as="geometry"/></mxCell><mxCell id="c11" value="GUARDRAIL 6 · Validación de la salida&lt;br&gt;tool estructurada, validación pedagógica, JSON plano → llamada sintética,&lt;br&gt;reintento si viene vacío, texto plano con tools = error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="620" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Resultado al coordinador → puerta de seguridad de contenido (código)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#5B2C83;strokeColor=#2B0F45;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="620" height="100" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="NO se usa del SDK (decisión de diseño)&lt;br&gt;&lt;br&gt;· EthicsGuard / ética del SDK → la reemplaza la constitución propia&lt;br&gt;· skills por BM25 → catálogo propio, determinista y auditable&lt;br&gt;· memoria y compactación → memoria propia del alumno&lt;br&gt;· swarm, DAG y task_delegate → reparto propio por rondas, sin DAG&lt;br&gt;· tools nativas web / cli / browser → bloqueadas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;verticalAlign=top;fontStyle=1;dashPattern=8 4;fillColor=#FFF3C4;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="640" height="230" as="geometry"/></mxCell><mxCell id="c23" value="Límites que conviene conocer&lt;br&gt;&lt;br&gt;· La constitución es una guarda de prompt: el modelo puede ignorarla.&lt;br&gt;  Las garantías duras son de código (política, puerta de seguridad,&lt;br&gt;  lista blanca, regla de acreditación).&lt;br&gt;· El hook del SDK es global y fail-open.&lt;br&gt;· Un tiempo máximo deja de esperar, pero no cancela la llamada al modelo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;verticalAlign=top;fontStyle=1;dashPattern=8 4;fillColor=#FFF3C4;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="760" y="380" width="640" height="260" as="geometry"/></mxCell><mxCell id="c24" value="Verificado en vivo (9B y 35B de HiveAgents)&lt;br&gt;ambos motores completan lecciones y generan programas;&lt;br&gt;Kev responde en ~0,7 s por consulta; el contrato de salida&lt;br&gt;es idéntico en legacy y sdk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>