FFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="340" height="100" as="geometry"/></mxCell><mxCell id="c7" value="Grade: correcto, confianza, método" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE08A;strokeColor=#6B4E00;fontColor=#000000;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="300" height="60" as="geometry"/></mxCell><mxCell id="c8" value="¿Currículo canónico o revisado&lt;br&gt;y confianza ≥ 0,8?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="550" width="300" height="120" as="geometry"/></mxCell><mxCell id="c9" value="Cuenta como evidencia&lt;br&gt;se registra por día" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="260" height="80" as="geometry"/></mxCell><mxCell id="c10" value="Cola de revisión docente&lt;br&gt;confianza media y hay docente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#5B2C83;strokeColor=#2B0F45;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="730" width="260" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Autodeclarado&lt;br&gt;currículo sin revisar o sin docente:&lt;br&gt;nunca acredita" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#A61B1B;strokeColor=#4D0A0A;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="730" width="260" height="90" as="geometry"/></mxCell><mxCell id="c12" value="El docente acepta con evidencia&lt;br&gt;(≥ 20 caracteres) o rechaza" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#5B2C83;strokeColor=#2B0F45;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="880" width="260" height="80" as="geometry"/></mxCell><mxCell id="c13" value="¿Evidencia que cuenta en ≥ 2 días&lt;br&gt;y prerrequisitos dominados?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3D3D3D;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="1000" width="270" height="140" as="geometry"/></mxCell><mxCell id="c14" value="Dominio del nodo&lt;br&gt;masterByEvidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="1030" width="260" height="70" as="geometry"/></mxCell><mxCell id="c15" value="¿Todos los nodos del nivel&lt;br&gt;dominados? Kev opina:&lt;br&gt;solo frena o pide revisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#B34A00;strokeColor=#5C2600;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="1180" width="260" height="140" as="geometry"/></mxCell><mxCell id="c16" value="Nivel superado&lt;br&gt;siguiente nivel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1E6B2E;strokeColor=#0B3A15;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="1215" width="220" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Revisión docente de nivel&lt;br&gt;hl_level_reviews" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#5B2C83;strokeColor=#2B0F45;fontColor=#FFFFFF;fontSize=14;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="1380" width="260" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#000000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxG